{
    "name": "rep98/dt-laravel-eloquent",
    "version": "1.0.0",
    "description": "Simple DataTable para Laravel Eloquent",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "datatable", "table"],
    "authors": [
        {
            "name": "Robert Pérez",
            "email": "delfinmundo@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "DTLaravelEloquent\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DTLaravelEloquent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DTLaravelEloquent\\RDataTableServiceProvider"
            ]
        }
    },    
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "illuminate/config": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/log": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "maatwebsite/excel": "^3.1"
    },
    "require-dev": {
        "orchestra/testbench": "^7.35|^8.15|^9.0",
        "phpunit/phpunit": "^10.4|^11.5"
    }
}
